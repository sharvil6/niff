# Copy to .env.tailscale (git-ignored) and fill in your own values.
# Auth key from the Tailscale admin console: reusable, pre-approved, tagged tag:niff.
TS_AUTHKEY=your-tailscale-auth-key
# Advertise the server tag (must match the key's tag and your policy's tagOwners).
TS_EXTRA_ARGS=--advertise-tags=tag:niff
# Name on the tailnet; default niff.
# TS_HOSTNAME=niff
