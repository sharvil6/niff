# Copy to .env.local (git-ignored) and fill in your own values, then run commands with:
#   uv run --env-file .env.local niff sync

NIFF_YNAB_TOKEN=your-ynab-personal-access-token
# Comma-separated; list every plan that should count toward net worth.
NIFF_YNAB_PLAN_IDS=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111
NIFF_DB_PATH=data/niff.db
# Built web page; default web/dist. Only needed when running from somewhere else.
# NIFF_WEB_DIST=web/dist
# Log level for Niff's own messages (DEBUG, INFO, WARNING, ERROR); default INFO.
# NIFF_LOG_LEVEL=INFO
